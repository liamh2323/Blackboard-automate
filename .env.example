# Blackboard Automate Configuration

# Blackboard Learn Ultra Domain & SAML SSO URL
BLACKBOARD_BASE_URL=https://tcd.blackboard.com
BLACKBOARD_SAML_PATH=/auth-saml/saml/login?apId=_3413_1&redirectUrl=https%3A%2F%2Ftcd.blackboard.com%2Fultra%2Fcourse

# Persistent Playwright Profile Path for 2FA Session Reuse
BROWSER_PROFILE_PATH=~/.blackboard_playwright_profile

# Download Directory (can point to ./downloads or a custom folder like ./Yr 2/Blackboard)
DOWNLOAD_DIR=./downloads

# Academic Term Filter (e.g. 202627 or leave blank for all enrolled courses)
CURRENT_TERM_FILTER=

# Web Dashboard Server Port & Host
HOST=127.0.0.1
PORT=8000

# Periodic Background Sync Interval (in hours)
SYNC_INTERVAL_HOURS=4

# Calendar Generation
ENABLE_CALENDAR_SYNC=true

# Optional AI Task Extraction from Announcements
# Options: none, gemini, openai, ollama
LLM_PROVIDER=none
LLM_API_KEY=
OLLAMA_URL=http://localhost:11434
